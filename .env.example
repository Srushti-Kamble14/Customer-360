# Tilores API credentials
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# GraphQL API endpoint for your Tilores instance
# Cloud: https://YOUR_INSTANCE.svc.tilores.io/YOUR_ID/graphql
# Local: http://localhost:8080/graphql
TILORES_API_URL=

# Bearer token for Tilores API authentication
# Generate from the Tilores dashboard or via OAuth2 client credentials
TILORES_TOKEN=

# OAuth2 client credentials (alternative to static token)
TILORES_CLIENT_ID=
TILORES_CLIENT_SECRET=
